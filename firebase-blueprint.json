{
  "entities": {
    "User": {
      "title": "User",
      "description": "Secret agent career record, statistics, spy rank progression, and player preferences.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Agent email address."
        },
        "displayName": {
          "type": "string",
          "maxLength": 100,
          "description": "Agent operative callsign or display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional user avatar URL."
        },
        "avatarId": {
          "type": "string",
          "maxLength": 50,
          "description": "Chosen operative avatar identifier."
        },
        "totalGames": {
          "type": "number",
          "description": "Total matches played."
        },
        "totalWins": {
          "type": "number",
          "description": "Total matches won."
        },
        "totalLosses": {
          "type": "number",
          "description": "Total matches lost."
        },
        "imposterWins": {
          "type": "number",
          "description": "Victories won while playing as the Imposter."
        },
        "civilianWins": {
          "type": "number",
          "description": "Victories won while playing as a Civilian detective."
        },
        "points": {
          "type": "number",
          "description": "Cumulative agent career score points."
        },
        "createdAt": {
          "type": "string",
          "description": "Agent registration timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Last profile update timestamp."
        }
      },
      "required": ["id", "email", "displayName", "avatarId", "totalGames", "totalWins", "totalLosses", "imposterWins", "civilianWins", "points"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Operative profile and persistent multiplayer career stats."
    }
  }
}
