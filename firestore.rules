rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.avatarId is string && data.avatarId.size() <= 50 &&
             data.totalGames is number && data.totalGames >= 0 &&
             data.totalWins is number && data.totalWins >= 0 &&
             data.totalLosses is number && data.totalLosses >= 0 &&
             data.imposterWins is number && data.imposterWins >= 0 &&
             data.civilianWins is number && data.civilianWins >= 0 &&
             data.points is number && data.points >= 0 &&
             data.keys().hasAll(['id', 'email', 'displayName', 'avatarId', 'totalGames', 'totalWins', 'totalLosses', 'imposterWins', 'civilianWins', 'points']);
    }

    // Health-check / boot connection test document
    match /test/{testId} {
      allow get: if isValidId(testId);
    }

    // Agent Operative Profiles & Career Records
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId) && isValidId(userId) && incoming().id == userId && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && incoming().id == existing().id && isValidUser(incoming());
      allow delete: if false;
    }
  }
}
